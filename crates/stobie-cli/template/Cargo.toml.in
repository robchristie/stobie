[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.97.1"
publish = false

{{#standalone}}
# A standalone workspace: nothing is inherited from an enclosing one.
[workspace]
resolver = "3"

{{/standalone}}
{{#member}}
# A member of the enclosing Cargo workspace, whose `members` must list it.
# Profiles, such as a smaller web build's, belong in the workspace's own
# Cargo.toml (see README.md).

{{/member}}
[lib]
crate-type = ["cdylib", "rlib"]

# Stobie is not on crates.io. Every Stobie dependency names the same pinned
# revision; to upgrade, change it everywhere and run `cargo update`.
# `.cargo/config.toml` can override it with a local checkout (see README.md).
{{#browser_only}}
# The browser is the only target: natively the UI crate builds without
# eframe, so `cargo test` needs no windowing or GPU libraries.
{{/browser_only}}
[dependencies]
{{stobie_dependencies}}egui = "=0.36.1"
serde = { version = "1.0.229", features = ["derive"] }

# The wasm-bindgen CLI must be exactly this version; `stobie build-web` checks.
[target.'cfg(target_arch = "wasm32")'.dependencies]
wasm-bindgen = "={{wasm_bindgen}}"
{{web_dependencies}}
{{#standalone}}

[profile.release]
lto = "thin"
codegen-units = 1
{{/standalone}}
